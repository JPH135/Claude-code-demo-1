# Fintech Opportunity Scanner - Environment Configuration
# Copy to .env and fill in available keys

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=true

# Crunchbase (optional - free tier: 200 req/month)
# Get key at: https://www.crunchbase.com/home
CRUNCHBASE_API_KEY=

# Companies House (optional but recommended - completely free)
# Get key at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# NewsAPI (optional - free tier: 100 req/day)
# Get key at: https://newsapi.org/
NEWSAPI_KEY=

# Database
DATABASE_URL=sqlite:///fintech_scanner.db

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=2
